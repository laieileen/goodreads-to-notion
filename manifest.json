{
  "manifest_version": 3,
  "name": "Goodreads to Notion",
  "version": "1.0.0",
  "description": "Automatically syncs new Goodreads shelf additions to your Notion reading database.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.goodreads.com/*",
    "https://api.notion.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Goodreads to Notion"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
